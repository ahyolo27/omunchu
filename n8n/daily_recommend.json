    {
      "parameters": {
        "jsCode": "const inputItems = $input.all();\n\nlet sum = 0;\nlet count = inputItems.length;\n\nfor (const item of inputItems) {\n  sum += item.json.tier;\n}\n\nconst avg = Math.floor(sum / count);\n\nconst max = avg;\nconst min = Math.max(1, avg - 2);\n\nfunction levelToTier(level) {\n    const groups = [\"b\", \"s\", \"g\", \"p\", \"d\", \"r\"];\n\n  const groupIndex = Math.floor((level - 1) / 5);\n  const group = groups[groupIndex];\n\n  const tierNumber = 5 - ((level - 1) % 5);\n\n  return group + tierNumber;\n}\n\nreturn [\n  {\n    json: {\n      maxTier: levelToTier(max),\n      minTier: levelToTier(min)\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        208,
        -96
      ],
      "id": "2f796cf2-c727-4514-b51b-30efcb14ea80",
      "name": "calcAvgTier"
    },
    {
      "parameters": {
        "url": "=https://solved.ac/api/v3/user/show?handle={{$json[\"boj_id\"]}}",
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
