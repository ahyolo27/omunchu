        "postgres": {
          "id": "Bo8GVupPeCn3MpIl",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "url": "https://solved.ac/api/v3/search/problem",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "query",
              "value": "={{\n(() => {\n  let max = $json.maxTier;\n  let min = $json.minTier;\n  const attemptCnt = $json.attemptCnt;\n\n  let solved;\n\n  if (attemptCnt === 1) {\n    solved = \"1000..\";\n  } else if (attemptCnt === 2) {\n    min = min - 1;\n    solved = \"1000..\";\n  } else {\n    solved = \"500..\";\n  }\n\n  return `tier:${min}..${max} solved:${solved}`;\n})()\n}}"
            },
            {
              "name": "sort",
              "value": "random"
            },
            {
              "name": "page",
              "value": "1"
            }
          ]
        },
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-solvedac-language",
              "value": "ko"
            }
          ]
        },
        "options": {}
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        576,
        -96
      ],
      "id": "8beea817-2927-4673-8b7f-6944959d04e8",
      "name": "searchProblems"
    },
    {
      "parameters": {
        "jsCode": "const searchNodeItems = $items(\"searchProblems\");\nconst candidates = searchNodeItems[0]?.json?.items ?? [];\n\nconst recommendedItems = $items(\"getRecommendation\");\nconst recommended = new Set(\n  recommendedItems.map(i => i.json.problem_id)\n);\n\nconst attemptCnt = $items(\"setAttemptCnt\")[0].json.attemptCnt;\n\n// 필터링\nconst filtered = candidates\n  .filter(p => p.titles?.some(t => t.language === \"ko\"))\n  .filter(p => !recommended.has(p.problemId));\n\n// 실패\nif (filtered.length === 0) {\n  return [{\n    json: {\n      empty: true,\n      attemptCnt\n    }\n  }];\n}\n\nconst picked = filtered[Math.floor(Math.random() * filtered.length)];\n\n// 성공\nreturn [{\n  json: {\n    ...picked,\n    empty: false,\n    attemptCnt\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
