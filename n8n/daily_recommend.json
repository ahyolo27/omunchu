    {
      "parameters": {
        "jsCode": "const searchNodeItems = $items(\"searchProblems\");\nconst candidates = searchNodeItems[0]?.json?.items ?? [];\n\nconst recommendedItems = $items(\"getRecommendation\");\nconst recommended = new Set(\n  recommendedItems.map(i => i.json.problem_id)\n);\n\n// 중복 제거\nconst filtered = candidates.filter(p =>\n  !recommended.has(p.problemId)\n);\n\nif (filtered.length === 0) {\n  return [];\n}\n\nconst picked = filtered[Math.floor(Math.random() * filtered.length)];\n\nreturn [{ json: picked }];"
      },
